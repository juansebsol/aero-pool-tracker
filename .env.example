# Optional. The official public Base HTTP RPC is used if this is unset.
# For reliable low-latency tracking, use dedicated Base HTTP + WebSocket endpoints.
BASE_HTTP_RPC_URL=https://mainnet.base.org
BASE_WS_RPC_URL=
# Background history / larger reconnect scans; keeps free-tier log limits off the live path.
BASE_HISTORY_RPC_URL=https://mainnet.base.org
# One local database. SQLite creates temporary -wal/-shm files while running.
DATABASE_PATH=./data/aerodrome.sqlite
# On first run, backfill approximately the last day for fast setup.
RECENT_BLOCKS=43200
# Set START_BLOCK=0 for complete history; requires much more time/RPC usage.
# Applied only on a fresh database. Change DATABASE_PATH to build a new index.
START_BLOCK=
BLOCK_CHUNK=2000
POLL_INTERVAL_MS=2000
REORG_DEPTH=20
